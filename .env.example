# ==========================================
# SEVIORA PHARMA - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. WHERE CONTACT FORM INQUIRIES GO:
CONTACT_RECEIVER_EMAIL=seviorapharma@gmail.com

# ------------------------------------------
# OPTION A: RESEND (RECOMMENDED FOR CLOUDFLARE)
# Free 3,000 emails/month: https://resend.com
# ------------------------------------------
# Get your API key from https://resend.com/api-keys
# NEVER commit your real key to GitHub!
RESEND_API_KEY=re_your_api_key_here

# Once you verify your custom domain on Resend, you can change this to:
# Seviora Inquiries <contact@seviorapharma.com>
RESEND_FROM_EMAIL="Seviora Inquiries <onboarding@resend.dev>"

# ------------------------------------------
# OPTION B: SMTP / GMAIL (ALTERNATIVE)
# If using Gmail, generate an App Password:
# https://myaccount.google.com/apppasswords
# ------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM="Seviora Pharma Website" <your-email@gmail.com>
